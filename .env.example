# ─────────────────────────────────────────────────────────────
# RGOLI ZEROFRAME OS — API (Laravel)
# Copy to .env and run `php artisan key:generate`.
# ─────────────────────────────────────────────────────────────

# App identity and environment (local | testing | production)
APP_NAME="RGOLI ZEROFRAME OS"
APP_ENV=local
# Generated by `php artisan key:generate`. Never commit a real key.
APP_KEY=
# Show stack traces. Must be false in production.
APP_DEBUG=true
# Public URL of this API (used for file download links and the docs).
APP_URL=http://localhost:8000

# Default UI/API language: ka (Georgian). Fallback for missing keys: en.
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# true = login page shows demo accounts and POST /admin/reset-demo is enabled.
APP_DEMO=true
# Shown in the UI footer.
RGOLI_VERSION=v5

# The React SPA. Used for CORS and for links in password-reset emails.
FRONTEND_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated (defaults to FRONTEND_URL).
# CORS_ALLOWED_ORIGINS=http://localhost:5173

BCRYPT_ROUNDS=12

# Logs. Auth and finance actions also go to storage/logs/auth-*.log and finance-*.log (JSON).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (docker-compose service "mysql"; use 127.0.0.1 when running PHP on the host).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rgoli
DB_USERNAME=rgoli
DB_PASSWORD=secret

# Sessions/cache use the database locally. Switch to redis in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue for notifications and exports. Run `php artisan queue:work`. Redis-ready.
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log

# Uploads. Disk "local" stores privately in storage/app/private; set "s3" for S3.
FILESYSTEM_DISK=local
UPLOADS_DISK=local
# Max size per file in KB (51200 = 50 MB) and max files per request.
UPLOADS_MAX_KB=51200
UPLOADS_MAX_FILES=10
# Allowed extensions, comma-separated.
UPLOADS_EXTENSIONS=pdf,dwg,png,jpg,jpeg,webp,gif,doc,docx,xls,xlsx,ppt,pptx,txt,csv,zip,rar,7z

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (password reset links). "log" writes mails to the log; use smtp + Mailpit in Docker.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rgoli.ge"
MAIL_FROM_NAME="${APP_NAME}"

# S3 (only when UPLOADS_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
