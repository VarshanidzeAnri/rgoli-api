    "finance_manager": {
      "name": "Finance Manager",
      "permissions": [
        "projects.view",
        "projects.view_all",
        "files.view",
        "files.upload",
        "files.delete_own",
        "finance.view",
        "client_payments.manage",
        "salary.request",
        "salary.approve",
        "reports.view",
        "reports.export"
      ]
    },
    "member": {
      "name": "Member",
      "permissions": [
        "projects.view",
        "issues.view",
        "issues.comment",
        "files.view",
        "files.upload",
        "files.delete_own",
        "map.view",
        "salary.request"
